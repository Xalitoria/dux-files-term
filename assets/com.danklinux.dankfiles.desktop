[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=File manager for the dank desktop
Exec=dfiles open %U
Icon=com.danklinux.dankfiles
Terminal=false
Categories=System;FileTools;FileManager;Utility;Qt;
Keywords=files;folders;browse;explorer;
MimeType=inode/directory;x-scheme-handler/trash;x-scheme-handler/sftp;x-scheme-handler/smb;
StartupNotify=true
StartupWMClass=com.danklinux.dankfiles
SingleMainWindow=true
